%}
{% set contributors = [] -%}
{% for category, commits in release["elements"].items() -%}
{% for parsed in commits -%}
{% set author = parsed.commit.author.name | trim -%}
{% if author -%}{% set _ = contributors.append(author) -%}{% endif -%}
{% for line in (parsed.commit.message | string).splitlines() -%}
{% if line.lower().startswith("co-authored-by:") -%}
{% set name = line.split(":", 1)[1].split("<", 1)[0] | trim -%}
{% if name -%}{% set _ = contributors.append(name) -%}{% endif -%}
{% endif -%}
{% endfor -%}
{% endfor -%}
{% endfor -%}
{% if contributors -%}
{{ "\n\n### Contributors\n\nThanks to everyone who contributed to this release!\n" }}
{% for name in contributors | unique | sort -%}
{{ "\n- " ~ (name | e) }}
{% endfor -%}
{% endif -%}
